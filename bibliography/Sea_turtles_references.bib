@article{erradi_sea_2026,
	title = {Sea {Turtle} {Strandings} {Along} the {Central}-{Southern} {Atlantic} {Coast} of {Morocco}},
	volume = {30},
	doi = {10.21608/ejabf.2026.533114},
	abstract = {Sea turtles are globally threatened marine reptiles exposed to increasing anthropogenic and environmental pressures. Despite the ecological importance of the Moroccan Atlantic coast, fine-scale information on strandings remains scarce along the central–southern coastline between Agadir and Laayoune. This study presents a regional assessment of strandings recorded between 2015 and 2026, combining retrospective records, active field surveys since June 2023, opportunistic reports, institutional records, and verified media sources. A total of 32 strandings were documented along approximately 600 km of coastline. Counts are presented descriptively rather than as evidence of temporal trends because monitoring effort was not standardized across years. Two species were identified: the loggerhead turtle (Caretta caretta, n = 22; 68.8\%) and the leatherback turtle (Dermochelys coriacea, n = 10; 31.3\%). Almost all individuals (31 of 32) were found dead, but the cause of death could not be determined. Fishing gear was observed in association with two individuals, providing evidence of fisheries interaction but not establishing a contribution to mortality; one additional individual showed an unconfirmed mark potentially consistent with fishing-line contact. Morphometric data were available for nine individuals; all seven measured loggerheads had carapace lengths consistent with juvenile or subadult size classes. Rocky shores and cliffs may contribute to under-detection. This study provides baseline data on sea turtle strandings along the central–southern Moroccan Atlantic coast and highlights the need for standardized monitoring and strengthened regional stranding networks.},
	journal = {Egyptian Journal of Aquatic Biology \& Fisheries},
	author = {Erradi, Mohamed and Ouaach, Abderrahim and Aksissou, Mustapha},
	month = oct,
	year = {2026},
	pages = {2833--2853},
	file = {Full Text PDF:C\:\\Users\\radis\\Zotero\\storage\\UIEBKHFK\\Erradi et al. - 2026 - Sea Turtle Strandings Along the Central-Southern Atlantic Coast of Morocco.pdf:application/pdf},
}

@article{touaf_assessing_2026,
	title = {Assessing bycatch of air-breathing marine megafauna in artisanal fisheries and fisher’s perceptions using interviews along the central {Atlantic} coast of {Morocco}},
	volume = {97},
	issn = {2352-4855},
	url = {https://www.sciencedirect.com/science/article/pii/S2352485526002471},
	doi = {10.1016/j.rsma.2026.104992},
	abstract = {Bycatch is a major threat to air-breathing marine megafauna. Moroccan waters are important fishing grounds, yet information on bycatch in coastal fisheries remains limited. While prior research has concentrated on bycatch from driftnet fisheries in the Mediterranean Moroccan coast, no comparable, multi-gear bycatch data exist for the artisanal fisheries across the central Atlantic coast. Therefore, this study assesses the risk posed to sea turtles, small cetaceans, and seabirds by artisanal fisheries along the central Atlantic coast of Morocco, based on face-to-face interviews with fishers in Agadir’s port and seven landing sites. Results indicate that bycatch occurs across all fishing gears throughout the range of the recorded species. Loggerhead turtles (Caretta caretta), rough-toothed dolphins (Steno bredanensis), common dolphins (Delphinus delphis), and northern gannets (Morus bassanus) were the most reported, with total reported bycatch counts of 90 sea turtles, 93 small cetaceans, and 78 seabirds in 2023 across the interviewed boats. Driftnets were identified as the primary gear responsible for bycatch, recording the highest rates, followed by trammel nets and gillnets. We also explored fisher’s perceptions of their catch, interactions with these taxa, and the associated negative impacts. Net damage, depredation by small cetaceans, and financial losses were the most frequently cited issues. This study provides the first multi-taxa and multi-gear documentation of bycatch in the Atlantic Moroccan artisanal fleet, establishing a critical baseline for future research and management efforts in this region.},
	urldate = {2026-10-10},
	journal = {Regional Studies in Marine Science},
	author = {Touaf, Mounia and Kaddouri, Abdelhamid and Jellal, Nadia and Hamiche, Fatima Zahra and Aksissou, Mustapha},
	month = may,
	year = {2026},
	keywords = {Bycatch, Morocco, Air-breathing marine megafauna, Artisanal fisheries, Central Atlantic coast, Interactions},
	pages = {104992},
	file = {ScienceDirect Snapshot:C\:\\Users\\radis\\Zotero\\storage\\RNIR3HXA\\S2352485526002471.html:text/html},
}

@article{keznine_preliminary_2022,
	title = {Preliminary data on bycatch and stranding of marine turtles in {Al} {Hoceima}, {Morocco}},
	volume = {26},
	doi = {10.21608/EJABF.2022.228714},
	abstract = {The area of Al Hoceima in Morocco occupies a strategic biological position concerning the trajectory of migratory species. Bycatch and standing data in this area are still lacking. However, knowledge of the number of stranded individuals/species and the bycatch rate/total catch for each fishing gear is crucial to adopting more effective conservation stratégies. Given this lack of information, monitoring of total standing and bycatch data was conducted from January To June 2021. Two different approaches were used in this study: on-board observation of longline, trawlers, and seiner vessels for bycatch rate and monitoring of the torture standing area through self- déclaration by sensitized fishermen. The results showed the existence of two species. Dermochelys Caracas (Vandelli, 1761) (1 individual) was stranded on Calabonita beach, and Caretta-Caretta (Linnaeus, 1758) was caught in longliners (two individuals) and trawlers (three individuals). No individuals were reported in purse seiners. For the first time, preliminary data on the bycatch and standing of tortures in Al Hoceima have been determined and this information is vital To implementing future conservation measures.},
	journal = {Egyptian Journal of Aquatic Biology and Fisheries},
	author = {Keznine, Mohamed and Aksissou, Mustapha and Benaissa, Hassan and Oubahaouali, Brahim and Barylo, Yevheniia},
	month = mar,
	year = {2022},
	pages = {253--261},
	file = {Full Text PDF:C\:\\Users\\radis\\Zotero\\storage\\S6Q4HKK7\\Keznine et al. - 2022 - Preliminary data on bycatch and stranding of marine turtles in Al Hoceima, Morocco.pdf:application/pdf},
}

